[Unit]
Description=Aplo's daily backup (DB dump + uploads)
Documentation=file:/opt/aplos/scripts/backup.sh
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=aplos
Group=aplos
EnvironmentFile=/opt/aplos/.env
Environment=APLOS_BACKUP_DIR=/var/backups/aplos
Environment=APLOS_RETENTION=30
Environment=APLOS_UPLOADS_DIR=/opt/aplos/var/uploads
ExecStart=/opt/aplos/scripts/backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aplos-backup

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/aplos
ReadOnlyPaths=/opt/aplos
