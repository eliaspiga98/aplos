# --- Backend (api) ---
# In dev lasciare 'development' (default Node). In produzione impostare
# 'production' per attivare logger compatto e disabilitare pino-pretty.
NODE_ENV=development

DATABASE_URL=postgresql://aplos:aplos_dev@localhost:5432/aplos
# Database "demo" separato (stesso schema). Gli operatori marcati come
# `usa_demo = true` (gestibile dall'admin) vedranno questo DB invece del
# principale. Utile per fornire al cliente un account di prova.
DEMO_DATABASE_URL=postgresql://aplos:aplos_dev@localhost:5432/aplos_demo
# Connessione read-only usata SOLO dal modulo AI (text-to-SQL). Lasciare vuoto
# per disabilitare l'AI, oppure usare un utente DB con SOLO privilegi SELECT.
READONLY_DATABASE_URL=
API_HOST=0.0.0.0
API_PORT=3001
# Cambia in produzione. Stringa lunga e casuale.
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
# Durata sessione in secondi (default 8 ore)
SESSION_TTL_SECONDS=28800
# Lascia true per HTTPS. Imposta false solo per una LAN HTTP fidata.
COOKIE_SECURE=false
# Origin del frontend per CORS in dev
WEB_ORIGIN=http://localhost:5173

# Storage allegati STL (path relativo alla root del repo o assoluto)
UPLOADS_DIR=var/uploads
UPLOAD_MAX_BYTES=52428800
# Eseguibile PostgreSQL usato per i backup. Il launcher Windows lo trova
# automaticamente dal PATH; valorizzare solo per installazioni personalizzate.
PG_DUMP_PATH=pg_dump

# Provider AI e modello sono gestiti a runtime nella tabella `app_settings`
# (modificabile dal pannello /impostazioni admin), non da queste variabili
# d'ambiente. Default seedato dalla migration 0004: provider=ollama,
# model=qwen2.5-coder:7b, ollama_url=http://localhost:11434,
# mlx_url=http://127.0.0.1:8080.

# --- Frontend (web) ---
# Letto da Vite. Deve includere il prefisso VITE_.
VITE_API_BASE_URL=http://localhost:3001
# Auto-logout dopo N minuti di inattività (tastiera/mouse). 0 = disabilitato.
VITE_INACTIVITY_LOGOUT_MINUTES=30
